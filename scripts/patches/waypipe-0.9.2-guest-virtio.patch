+/* Keep this descriptor open while QEMU reconnects. Closing and probing
+ * repeatedly sends guest port-close events and can drop the new connection. */
+static int connect_to_virtio(struct socket_path path)
+{
+	char device[sizeof(((struct sockaddr_un *)0)->sun_path) + 32];
+	snprintf(device, sizeof(device), "%s/%s", path.folder,
+			path.filename->sun_path);
+	int fd = open(device, O_RDWR | O_CLOEXEC);
+	if (fd == -1) {
+		wp_error("Cannot open virtio port '%s': %s", device, strerror(errno));
+		return -1;
+	}
+
+	for (int attempt = 0; attempt < 50 && !shutdown_flag; attempt++) {
+		struct pollfd port = {fd, POLLOUT, 0};
+		int result = poll(&port, 1, 100);
+		if (result == -1 && errno == EINTR) {
+			continue;
+		}
+		if (result < 0 || (port.revents & (POLLERR | POLLNVAL))) {
+			break;
+		}
+		if ((port.revents & (POLLOUT | POLLHUP)) == POLLOUT) {
+			return fd;
+		}
+		if (port.revents & POLLHUP) {
+			const struct timespec delay = {0, 100000000};
+			nanosleep(&delay, NULL);
+		}
+	}
+	wp_error("HiSH Wayland did not connect to virtio port '%s'", device);
+	checked_close(fd);
+	return -1;
+}
