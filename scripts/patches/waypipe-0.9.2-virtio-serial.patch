+/* Each VM application gets its own compositor connection and Waypipe
+ * state. Keep the virtio-side listener so QEMU can reconnect. */
+static int run_virtio_client(int cwd_fd, int channelsock,
+		const struct main_config *config, struct socket_path display_path)
+{
+	int retcode = EXIT_SUCCESS;
+	pid_t no_child = 0;
+	while (!shutdown_flag) {
+		struct connection_token token;
+		int channel = accept_channel(channelsock, &no_child, config,
+				&token, &retcode, true);
+		if (channel == -1) {
+			break;
+		}
+
+		int display_fd = -1;
+		if (connect_to_socket(cwd_fd, display_path, NULL, &display_fd) == -1) {
+			checked_close(channel);
+			retcode = EXIT_FAILURE;
+			break;
+		}
+
+		struct main_config session_config = *config;
+		apply_conn_header(token.header, &session_config);
+		main_interface_loop(channel, display_fd, -1, &session_config, true);
+	}
+	checked_close(channelsock);
+	return retcode;
+}
