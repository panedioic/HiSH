+		/* QEMU may close the chardev connection before the guest
+		 * opens the virtio port. Wait for a complete guest token. */
+		size_t received = 0;
+		while (received < sizeof(conn_id) && !shutdown_flag) {
+			struct pollfd handshake = {chanclient, POLLIN, 0};
+			int ready = poll(&handshake, 1, -1);
+			if (ready < 0 && errno == EINTR) {
+				continue;
+			}
+			if (ready <= 0) {
+				break;
+			}
+			ssize_t count = read(chanclient, (char *)&conn_id + received,
+					sizeof(conn_id) - received);
+			if (count < 0 && errno == EINTR && !shutdown_flag) {
+				continue;
+			}
+			if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) &&
+					!(handshake.revents & (POLLHUP | POLLERR))) {
+				continue;
+			}
+			if (count <= 0) {
+				break;
+			}
+			received += (size_t)count;
+		}
+		if (received != sizeof(conn_id)) {
+			checked_close(chanclient);
+			chanclient = -1;
+			continue;
